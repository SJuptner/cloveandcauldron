# Get these from https://www.sanity.io/manage after creating your project
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: only needed if you want draft/preview content in local dev
SANITY_API_READ_TOKEN=

# Get these from app.kit.com > Account Settings > Developer (v3 API key) and your form's settings
KIT_API_KEY=
KIT_FORM_ID=

# Google Analytics measurement ID from analytics.google.com > Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=
